# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# chaves públicas (publishable) — necessárias no build; podem ser versionadas
!.env.production
!.env.example

# vercel
.vercel

# Diario do aluno: notas com PII de TERCEIROS. Repo e publico.
/data/diario/*.json

# typescript
*.tsbuildinfo
next-env.d.ts
supabase/.temp/

# Skills instaladas por `npx skills add` (reinstalaveis; ver CLAUDE.md)
.agents/
.claude/skills/
skills-lock.json

# Suíte E2E (Playwright): artefatos de execução, nunca versionados.
# `test-results/` guarda vídeo, trace e captura das falhas — inclui a TELA
# LOGADA da conta de QA, com nome de cliente real visível na agenda da equipe.
# Versionar isso publicaria dado pessoal de terceiro num repo de código.
/test-results/
/e2e/.relatorio/
/playwright-report/
