# Copie para .env.local (desenvolvimento). As chaves abaixo são públicas.
NEXT_PUBLIC_SUPABASE_URL=https://mbvybujpkwuorhtdzcde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ZCwMkDCoJ5_H7DHZ476TsQ_CesBbG9J

# URL pública do portal (usada nos links dos e-mails).
NEXT_PUBLIC_APP_URL=https://programa.timeholdingbrasil.com.br

# Resend — envio de e-mails transacionais (credenciais / liberação de acesso).
# RESEND_API_KEY é SEGREDO: em produção configure no painel da Hostinger, não aqui.
# O domínio do EMAIL_FROM precisa estar VERIFICADO na Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Time Holding Brasil <acesso@programa.timeholdingbrasil.com.br>

# Segredo do job diário de manutenção do Plantão de Dúvidas (NPS pendente +
# expurgo de sessões/eventos). Comparado ao header enviado pelo pg_cron —
# sem ele, a rota /api/plantao/manutencao responde 401. SEGREDO: gerar valor
# aleatório longo e configurar só no painel da Hostinger, nunca aqui.
#
# ⚠️ MÍNIMO 16 CARACTERES. As RPCs gps.plantao_expurgar / _nps_pendente /
# _marcar_nps_enviado exigem o MESMO valor no banco:
#     alter role authenticator set app.plantao_manutencao_segredo = '<valor>';
# A guarda falha FECHADO: enquanto esse setting não existir (ou tiver menos de
# 16 caracteres), as 3 RPCs recusam TODAS as chamadas com erro 42501. Isso é
# proposital — a versão anterior comparava contra current_setting(...,true),
# que devolve NULL quando o setting não existe, fazendo a comparação virar
# NULL e o DELETE em massa EXECUTAR para qualquer chamada anônima.
PLANTAO_MANUTENCAO_SEGREDO=

# ⚠️ Ainda NÃO configurada no painel da Hostinger (pendência de deploy):
# sem ela, cada build gera uma chave nova e Server Actions em voo no
# momento do deploy falham (erro de decriptação). Gerar um valor aleatório
# de 32 bytes em base64 e fixar no painel — NUNCA versionar o valor real.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
